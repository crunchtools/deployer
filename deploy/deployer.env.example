# The deployer unit's environment. The real file is mode 0600: it carries the
# RT and Nagios passwords, and this example carries none of them.
#
# Everything here is a property of the deployment, not of the program. There
# are no built-in paths and no default RT: a missing variable is exit 2, "could
# not run", rather than a guess at what was meant.

# RT. The URL is the loopback port the rt container publishes, not the public
# name and not the container's IP. The public name sits behind Cloudflare
# Access, which would need a service token this program has no reason to hold;
# the container IP is on a network the host cannot reach and changes on
# restart anyway.
RT_URL=http://127.0.0.1:8084
RT_USER=CHANGE_ME
RT_PASSWORD=CHANGE_ME
# Required, and not UTC. RT renders its dates with no zone in the string, and
# RT_SiteConfig.pm decides which zone that is, while this container's clock is
# UTC. Reading it wrong is a five-hour error in the one number the 30-minute
# build deadline is measured from.
RT_TIMEZONE=America/New_York

# Nagios. Again the loopback port the container publishes.
NAGIOS_CMD_URL=http://127.0.0.1:8096/nagios/cgi-bin/cmd.cgi
NAGIOS_USER=CHANGE_ME
NAGIOS_PASSWORD=CHANGE_ME
# The author written on every window this program opens, and the author it
# will cancel windows for. Cancelling is filtered on it, so that cleaning up
# after a deploy cannot close a window a person opened by hand to work on the
# same service.
NAGIOS_COMMENT_AUTHOR=deployer
# The NAGIOS SERVER's own zone, which is not this container's. cmd.cgi takes
# start_time as naive wall clock and reads it in its zone, so a UTC string
# opened every maintenance window five hours late and deleted it before it
# began -- both commands succeeding and nothing suppressed. Required from
# 0.1.4, because a wrong value here is silent.
NAGIOS_TIMEZONE=America/New_York

# Paths inside the container. The state directory is mounted at the same path
# it has on the host, so this program, the auto-update guard and the Nagios
# check all name one directory.
DEPLOYER_CONFIG=/config/services.toml
DEPLOYER_STATE=/var/lib/deployer
DEPLOYER_QUEUE=Deploy
PODMAN_SOCKET=/run/podman/podman.sock
