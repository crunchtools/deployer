# rootsofthevalley.org-pg-dump@.service — the pre-deploy database dump.
#
# Started by the deployer, never by hand and never at boot: the registry row's
#   pre_deploy = { kind = "pg_dump", unit = "rootsofthevalley.org-pg-dump@.service" }
# makes it start `rootsofthevalley.org-pg-dump@<suffix>.service` before every
# restart of rootsofthevalley.org, where <suffix> is the outgoing release's
# rollback tag suffix, and wait for it. A failure here refuses the deploy with
# the old release still running.
#
# THE CONTRACT is one path. The instance leaves a `pg_dump -Fc` archive at
# /var/lib/deployer/dumps/rootsofthevalley.org/%i.dump, which the deployer
# checks for its PGDMP header and a modification time from this run, and then
# rotates to the newest two like the rollback tags they sit beside. It writes
# to a partial name and renames, so a dump that dies half way is never mistaken
# for one that finished; the deployer sweeps partials after the next good run.
#
# WHY A HOST UNIT. The deployer cannot exec into a container, by design, and
# PostgreSQL in this container listens only on its own loopback with trust
# auth, so a network dump would mean opening the database. This unit runs as
# root on the host, where `podman exec` is ordinary, and what it runs is this
# reviewed file. pg_dump is the container's own, so it always matches the
# server's major version. /usr/pgsql-17/bin because the image puts no symlink
# for pg_dump on PATH.
#
# /var/lib/deployer/dumps inherits container_file_t from the state directory's
# static fcontext, so the deployer container can read and rotate what this
# writes. Root-only: UMask 0077 and a 0700 directory, because a dump is the
# whole database, users and sessions included.

[Unit]
Description=Pre-deploy pg_dump of rootsofthevalley.org (%i)
Documentation=https://github.com/crunchtools/deployer
Requires=rootsofthevalley.org.service
After=rootsofthevalley.org.service

[Service]
Type=oneshot
UMask=0077
# Well past the ~10s the nightly backup takes, and inside the registry row's
# pre_deploy timeout (default 300s), so systemd ends a hung dump before the
# deployer gives up waiting on it.
TimeoutStartSec=240
ExecStartPre=/usr/bin/mkdir -p -m 0700 /var/lib/deployer/dumps/rootsofthevalley.org
ExecStart=/bin/sh -c 'set -e; d=/var/lib/deployer/dumps/rootsofthevalley.org; /usr/bin/podman exec rootsofthevalley.org /usr/pgsql-17/bin/pg_dump -Fc -U postgres rotv > "$d/.%i.partial"; mv "$d/.%i.partial" "$d/%i.dump"'
