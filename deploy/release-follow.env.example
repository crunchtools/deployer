# The release-follow unit's environment. The real file is mode 0600 and carries
# the RT password; this example carries none of it.
#
# NOT deployer.env and NOT cve-enqueue.env. release-follow files Deploy tickets
# as its own RT user, `follower`, and refuses to run as anyone else: a row in
# services.toml opts in to being followed by listing `follower` in its
# `requestors`, so the name these tickets arrive under IS the authorisation.
#
# Provision on the host: create the `follower` RT user with CreateTicket,
# ShowTicket and SeeQueue on the Deploy queue (OwnTicket too, so a ticket the
# deployer hands back can be owned by it); store these values in the vault under
# the release-follow.crunchtools.com secret; enable
# srv-secrets@release-follow.crunchtools.com.service to decrypt them to the
# EnvironmentFile the unit names.

RT_URL=http://127.0.0.1:8084
RT_USER=follower
RT_PASSWORD=CHANGE_ME
# Required, and not UTC: RT renders its dates with no zone in the string.
RT_TIMEZONE=America/New_York
